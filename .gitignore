*.iml
.gradle/
.kotlin/
local.properties
.idea/
.DS_Store
build/
captures/
.externalNativeBuild/
.cxx/

# llama.cpp-Quellen, falls jemand mit scripts/build-llama-server.sh baut.
.llama.cpp/

# Modellgewichte werden nie eingecheckt.
*.gguf
*.onnx
*.litertlm
*.bin

# Die Android-Werkzeuge, die Neon zum Bauen einer App braucht.
#
# aapt2 und seine Abhängigkeiten holt scripts/fetch-android-tools.sh gegen festgenagelte
# Prüfsummen aus dem Termux-Depot, und die CI ruft das Skript vor dem APK-Bau auf. Anders
# als llama-server sind sie **kein** Bauergebnis, sondern ein Download — elf Megabyte
# fremder Binärdateien in der Versionsgeschichte wären nur eine zweite Wahrheit neben den
# Prüfsummen.
app/src/main/jniLibs/arm64-v8a/*.so

# Das gebaute llama-server-Programm ist ausdrücklich Teil des Repositories: Ohne es
# könnte niemand ohne NDK eine funktionierende APK bauen — und genau das ist das Ziel.
!app/src/main/jniLibs/arm64-v8a/libllama-server.so

# Der Python-Starter aus demselben Grund: Er braucht das NDK, die CI hat keines, und er ist
# acht Kilobyte groß. scripts/build-python-launcher.sh baut ihn neu, wenn die Python-Fassung
# wechselt — worauf scripts/fetch-python.sh ausdrücklich hinweist, wenn es nicht mehr passt.
!app/src/main/jniLibs/arm64-v8a/libpython-launcher.so

# Trainingsausgaben und eigene Aufnahmen.
tools/train-wakeword/recordings/
tools/train-wakeword/.venv/

!gradle/wrapper/gradle-wrapper.jar

# Die Python-Umgebung holt scripts/fetch-python.sh von python.org, gegen eine festgenagelte
# Prüfsumme, und die CI ruft das Skript vor dem APK-Bau auf. Sieben Megabyte Standardbibliothek
# in der Versionsgeschichte wären nur eine zweite Wahrheit neben der Prüfsumme.
app/src/main/assets/python-stdlib.zip
