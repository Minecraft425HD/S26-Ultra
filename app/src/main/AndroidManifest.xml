<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Damit Neon eine selbst gebaute App zur Installation anbieten kann. Ohne diese
      Berechtigung weist Android den Intent wortlos ab.

      Sie erlaubt nicht das Installieren, sondern nur das Anbieten: Den Systemdialog
      bestaetigt der Nutzer. Bei einer App, die ein Sprachmodell gerade geschrieben hat,
      ist genau das richtig.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".NeonApplication"
        android:allowBackup="false"
        android:icon="@android:drawable/ic_btn_speak_now"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Neon">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Neon"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <!--
          Zum Weitergeben des Protokolls als Datei.

          Vorher ging es als Text in Intent.EXTRA_TEXT. Android überträgt Intent-Inhalte
          über Binder, dessen Transaktionsgrenze bei rund einem Megabyte liegt — praktisch
          darunter. Ein Protokoll mit der Ausgabe von llama-server sprengt das, und was
          ankam, war mitten im Wort abgeschnitten. Ein Dateizeiger hat diese Grenze nicht.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.protokoll"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
